# Spot connection
SPOT_HOSTNAME=192.168.80.3
SPOT_USERNAME=user
# Preferred: keep the host-side password in ./secrets/spot_password.txt and leave this container path unchanged.
SPOT_PASSWORD_FILE=/run/spot-secrets/spot_password.txt
# Backward-compatible fallback if you cannot use a file yet:
# SPOT_PASSWORD=
SPOT_NAME=spot
SPOT_FRAME_PREFIX=

# ROS 2 / DDS
ROS_DOMAIN_ID=17
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Leave DDS_INTERFACE empty to let CycloneDDS choose. Set to wlxc83a35b4ce1d only when needed.
DDS_INTERFACE=
# Comma-separated peer IPs, for example: 10.186.13.7,10.186.13.39
DDS_PEERS=

# Visualization
DISPLAY=:0
LAUNCH_RVIZ=False

# Velodyne VLP-16-A detected on this robot
VELODYNE_DEVICE_IP=192.168.1.201
# Use SLAM-local frame names so mrg_slam can run beside spot-driver without owning Spot's odom -> body TF.
VELODYNE_FRAME=slam_velodyne
VELODYNE_PARENT_FRAME=slam_body
VELODYNE_X=0.0
VELODYNE_Y=0.0
VELODYNE_Z=0.25
VELODYNE_ROLL=0.0
VELODYNE_PITCH=0.0
VELODYNE_YAW=0.0

# MOLA LO
MOLA_LIDAR_TOPIC=/velodyne/points_mola
MOLA_TF_BASE_LINK=slam_body
MOLA_USE_MOLA_GUI=False
MOLA_USE_RVIZ=False
MOLA_PUBLISH_REP105=True
MOLA_IGNORE_LIDAR_POSE_FROM_TF=False
MOLA_GENERATE_SIMPLEMAP=True

# mrg_slam 3D mapping
MRG_SLAM_CONFIG=/spot_bringup/config/mrg_slam_spot.yaml
MRG_RVIZ_CONFIG=/spot_bringup/rviz/mrg_slam_spot.rviz
MRG_USE_SIM_TIME=False
MRG_X=0.0
MRG_Y=0.0
MRG_Z=0.0
MRG_ROLL=0.0
MRG_PITCH=0.0
MRG_YAW=0.0
MRG_INIT_ODOM_TOPIC=NONE
MRG_INIT_POSE_TOPIC=NONE
MRG_RESULT_DIR=

# Publishes map -> odom so RViz can use map as fixed frame while showing Spot's TF tree.
MAP_ODOM_MAP_FRAME=map
MAP_ODOM_SLAM_BASE_FRAME=slam_body
MAP_ODOM_SPOT_ODOM_FRAME=odom
MAP_ODOM_SPOT_BASE_FRAME=body
MAP_ODOM_PUBLISH_RATE_HZ=20.0
MAP_ODOM_SYNC_ODOM_TO_SLAM_STAMP=True
MAP_ODOM_STAMP_WITH_SLAM_TIME=False
MAP_ODOM_TRANSLATION_FILTER_ALPHA=1.0
MAP_ODOM_ROTATION_FILTER_ALPHA=1.0
MAP_ODOM_TRANSLATION_DEADBAND_M=0.0
MAP_ODOM_ROTATION_DEADBAND_RAD=0.0

# MRG + slam_toolbox hybrid 2D/3D mapping
MRG_HYBRID_RVIZ_CONFIG=/spot_bringup/rviz/mrg_hybrid_slam_toolbox.rviz
MRG_HYBRID_SLAM_TOOLBOX_CONFIG=/spot_bringup/config/slam_toolbox_mrg_hybrid.yaml
MRG_HYBRID_USE_SIM_TIME=False
MRG_HYBRID_CLOUD_TOPIC=/velodyne/points
MRG_HYBRID_RAW_SCAN_TOPIC=/slam_toolbox/scan_raw
MRG_HYBRID_SCAN_TOPIC=/slam_toolbox/scan
MRG_HYBRID_RESTAMP_SCAN=True
MRG_HYBRID_LASERSCAN_TARGET_FRAME=slam_velodyne
MRG_HYBRID_SCAN_FRAME=slam_toolbox_velodyne
MRG_HYBRID_BASE_FRAME=slam_toolbox_velodyne
MRG_HYBRID_ODOM_FRAME=slam_toolbox_velodyne
MRG_HYBRID_MAP_FRAME=map
MRG_HYBRID_SCAN_MIN_HEIGHT=-0.15
MRG_HYBRID_SCAN_MAX_HEIGHT=0.35
MRG_HYBRID_SCAN_ANGLE_INCREMENT=0.008726646
MRG_HYBRID_SCAN_TIME=0.1
MRG_HYBRID_SCAN_RANGE_MIN=0.8
MRG_HYBRID_SCAN_RANGE_MAX=45.0
MRG_HYBRID_SCAN_TRANSFORM_TOLERANCE=0.25
MRG_HYBRID_TRANSFORM_PUBLISH_PERIOD=0.05
MRG_HYBRID_MAP_ODOM_MAP_FRAME=map
MRG_HYBRID_MAP_ODOM_SLAM_BASE_FRAME=slam_body
MRG_HYBRID_MAP_ODOM_SPOT_ODOM_FRAME=odom
MRG_HYBRID_MAP_ODOM_SPOT_BASE_FRAME=body
MRG_HYBRID_MAP_ODOM_POSE_TOPIC=/slam_toolbox/pose
MRG_HYBRID_MAP_ODOM_SLAM_TOOLBOX_BASE_FRAME=slam_toolbox_velodyne
MRG_HYBRID_MAP_ODOM_USE_SLAM_TOOLBOX_TF=True
MRG_HYBRID_MAP_ODOM_PUBLISH_RATE_HZ=20.0
MRG_HYBRID_MAP_ODOM_LOOKUP_TIMEOUT_SEC=0.2
MRG_HYBRID_MAP_ODOM_POSE_TIMEOUT_SEC=2.0
MRG_HYBRID_MAP_ODOM_SYNC_ODOM_TO_POSE_STAMP=False
MRG_HYBRID_MAP_ODOM_STAMP_WITH_POSE_TIME=False
MRG_HYBRID_MAP_ODOM_USE_MRG_Z=True
MRG_HYBRID_MAP_ODOM_USE_MRG_ROLL_PITCH=False
MRG_HYBRID_MAP_ODOM_FALLBACK_TO_MRG=True
MRG_HYBRID_MAP_ODOM_TRANSLATION_Z_OFFSET_M=0.0
MRG_HYBRID_MAP_ODOM_TRANSLATION_FILTER_ALPHA=0.8
MRG_HYBRID_MAP_ODOM_ROTATION_FILTER_ALPHA=0.8
MRG_HYBRID_MAP_ODOM_TRANSLATION_DEADBAND_M=0.005
MRG_HYBRID_MAP_ODOM_ROTATION_DEADBAND_RAD=0.005

# RTAB-Map lidar ICP SLAM profile
RTABMAP_RVIZ_CONFIG=/spot_bringup/rviz/rtabmap_spot.rviz
RTABMAP_NAMESPACE=rtabmap
RTABMAP_SCAN_CLOUD_TOPIC=/rtabmap/velodyne_points
RTABMAP_FRAME_ID=rtabmap_body
RTABMAP_ODOM_FRAME_ID=rtabmap_odom
RTABMAP_MAP_FRAME_ID=map
RTABMAP_DATABASE_PATH=/spot_bringup/maps/rtabmap_spot.db
RTABMAP_DELETE_DB_ON_START=True
RTABMAP_DETECTION_RATE=2.0
RTABMAP_QOS=2
RTABMAP_WAIT_FOR_TRANSFORM=0.3
RTABMAP_VOXEL_SIZE=0.15
RTABMAP_MAX_CORRESPONDENCE_DISTANCE=1.5
RTABMAP_RANGE_MIN=0.9
RTABMAP_RANGE_MAX=50.0
RTABMAP_LOG_LEVEL=info
RTABMAP_GLOBAL_MAP_ASSEMBLER_ENABLED=True
RTABMAP_GLOBAL_MAP_REGENERATE_LOCAL_GRIDS=False
RTABMAP_GLOBAL_CLOUD_TOPIC=/rtabmap/global_cloud_map
RTABMAP_GLOBAL_GRID_TOPIC=/rtabmap/global_grid_prob_map
RTABMAP_OCTOMAP_TREE_DEPTH=16
RTABMAP_LIVE_CLOUD_ASSEMBLER_ENABLED=False
RTABMAP_LIVE_CLOUD_TOPIC=/rtabmap/live_cloud_map
RTABMAP_LIVE_CLOUD_MAX_CLOUDS=20
RTABMAP_LIVE_CLOUD_SKIP_CLOUDS=1
RTABMAP_LIVE_CLOUD_LINEAR_UPDATE=0.10
RTABMAP_LIVE_CLOUD_ANGULAR_UPDATE=0.0872665
RTABMAP_LIVE_CLOUD_WAIT_FOR_TRANSFORM=1.0
RTABMAP_LIVE_CLOUD_VOXEL_SIZE=0.10
RTABMAP_LIVE_CLOUD_NOISE_RADIUS=0.0
RTABMAP_LIVE_CLOUD_NOISE_MIN_NEIGHBORS=5
RTABMAP_VELODYNE_DEVICE_IP=192.168.1.201
RTABMAP_VELODYNE_PACKETS_TOPIC=/rtabmap/velodyne_packets
RTABMAP_VELODYNE_POINTS_TOPIC=/rtabmap/velodyne_points
RTABMAP_VELODYNE_MOLA_POINTS_TOPIC=/rtabmap/velodyne_points_mola
RTABMAP_VELODYNE_FRAME=rtabmap_velodyne
RTABMAP_VELODYNE_PARENT_FRAME=rtabmap_body
RTABMAP_VELODYNE_X=0.0
RTABMAP_VELODYNE_Y=0.0
RTABMAP_VELODYNE_Z=0.25
RTABMAP_VELODYNE_ROLL=0.0
RTABMAP_VELODYNE_PITCH=0.0
RTABMAP_VELODYNE_YAW=0.0
RTABMAP_MAP_ODOM_MAP_FRAME=map
RTABMAP_MAP_ODOM_SLAM_BASE_FRAME=rtabmap_body
RTABMAP_MAP_ODOM_SPOT_ODOM_FRAME=odom
RTABMAP_MAP_ODOM_SPOT_BASE_FRAME=body
RTABMAP_MAP_ODOM_PUBLISH_RATE_HZ=20.0
RTABMAP_MAP_ODOM_SYNC_ODOM_TO_SLAM_STAMP=True
RTABMAP_MAP_ODOM_STAMP_WITH_SLAM_TIME=False
RTABMAP_MAP_ODOM_TRANSLATION_FILTER_ALPHA=1.0
RTABMAP_MAP_ODOM_ROTATION_FILTER_ALPHA=1.0
RTABMAP_MAP_ODOM_TRANSLATION_DEADBAND_M=0.0
RTABMAP_MAP_ODOM_ROTATION_DEADBAND_RAD=0.0
RTABMAP_MAP_ODOM_YAW_ONLY=True
RTABMAP_MAP_ODOM_LOCK_Z=True
RTABMAP_MAP_ODOM_TRANSLATION_Z_OFFSET_M=0.45

# LIO-SAM experimental profile
LIO_SAM_CONFIG=/spot_bringup/config/lio_sam_spot.yaml
LIO_SAM_RVIZ_CONFIG=/spot_bringup/rviz/lio_sam_spot.rviz
LIO_SAM_IMU_TOPIC=/lio_sam/imu
# auto tries the licensed Spot SDK inertial stream first, then falls back to SDK kinematic state if unavailable.
SPOT_SDK_IMU_SOURCE_MODE=auto
SPOT_SDK_IMU_FRAME=liosam_body
SPOT_SDK_IMU_FALLBACK_RATE_HZ=100.0
SPOT_SDK_IMU_FALLBACK_USE_VELOCITY_DERIVATIVE=True
SPOT_SDK_IMU_FALLBACK_ACCEL_FILTER_COEFF=0.3
SPOT_SDK_IMU_ADD_GRAVITY=True
SPOT_SDK_IMU_GRAVITY=9.80511
LIO_SAM_VELODYNE_DEVICE_IP=192.168.1.201
LIO_SAM_VELODYNE_FRAME=liosam_velodyne
LIO_SAM_VELODYNE_PARENT_FRAME=liosam_body
LIO_SAM_VELODYNE_X=0.0
LIO_SAM_VELODYNE_Y=0.0
LIO_SAM_VELODYNE_Z=0.25
LIO_SAM_VELODYNE_ROLL=0.0
LIO_SAM_VELODYNE_PITCH=0.0
LIO_SAM_VELODYNE_YAW=0.0
# Opt-in only: start the lio-sam-map-odom-bridge service only after LIO-SAM is stable.
LIO_SAM_MAP_ODOM_MAP_FRAME=map
LIO_SAM_MAP_ODOM_SLAM_BASE_FRAME=liosam_body
LIO_SAM_MAP_ODOM_SPOT_ODOM_FRAME=odom
LIO_SAM_MAP_ODOM_SPOT_BASE_FRAME=body
LIO_SAM_MAP_ODOM_PUBLISH_RATE_HZ=20.0

# FAST-LIO2 (spark-fast-lio) profile
FAST_LIO_CONFIG=/spot_bringup/config/fast_lio_spot.yaml
FAST_LIO_RVIZ_CONFIG=/spot_bringup/rviz/fast_lio_spot.rviz
FAST_LIO_LIDAR_TOPIC=/velodyne/points
FAST_LIO_IMU_TOPIC=/fast_lio/imu
FAST_LIO_IMU_FRAME=fastlio_body
FAST_LIO_IMU_SOURCE_MODE=auto
FAST_LIO_IMU_FALLBACK_RATE_HZ=100.0
FAST_LIO_IMU_FALLBACK_USE_VELOCITY_DERIVATIVE=False
FAST_LIO_IMU_ADD_GRAVITY=True
FAST_LIO_IMU_GRAVITY=9.80511
FAST_LIO_VELODYNE_DEVICE_IP=192.168.1.201
FAST_LIO_VELODYNE_FRAME=fastlio_velodyne
FAST_LIO_VELODYNE_PARENT_FRAME=fastlio_body
FAST_LIO_VELODYNE_X=0.0
FAST_LIO_VELODYNE_Y=0.0
FAST_LIO_VELODYNE_Z=0.25
FAST_LIO_VELODYNE_ROLL=0.0
FAST_LIO_VELODYNE_PITCH=0.0
FAST_LIO_VELODYNE_YAW=0.0
# Opt-in: enable the fastlio-bridge profile to publish map -> odom.
FAST_LIO_MAP_ODOM_MAP_FRAME=fastlio_map
FAST_LIO_MAP_ODOM_SLAM_BASE_FRAME=fastlio_body
FAST_LIO_MAP_ODOM_SPOT_ODOM_FRAME=odom
FAST_LIO_MAP_ODOM_SPOT_BASE_FRAME=body
FAST_LIO_MAP_ODOM_PUBLISH_RATE_HZ=20.0
